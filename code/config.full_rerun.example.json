{
  "execution_mode": "openai-compatible",
  "inputs": {
    "source_packets_dir": "data/model_facing/main_94/source_packets",
    "evidence_banks_dir": "data/model_facing/main_94/canonical_evidence_banks",
    "sample_manifest_csv": "data/model_facing/main_94/sample_manifest.csv",
    "hidden_outcomes_csv": "data/evaluation_only/car_1_5_outcomes.csv"
  },
  "experiment": {
    "treatments": ["T1", "T2", "T3", "T4"],
    "profiles": [
      "retail_day_trader",
      "retail_swing_trader",
      "retail_long_term_fundamental",
      "institutional_event_driven_hedge_fund",
      "institutional_prop_trader",
      "institutional_investment_advisor"

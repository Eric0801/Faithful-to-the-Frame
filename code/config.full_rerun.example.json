    "downstream_model_families": ["gpt-5.2"],
    "downstream_model_override": "gpt-5.2",
    "upstream_temperature": 0.2,
    "downstream_temperature": 0.0,
    "upstream_max_tokens": 900,
    "downstream_max_tokens": 700,
    "workers": 1
  },
  "limits": {
    "max_upstream_jobs": null,
    "max_downstream_requests": null
  }
}
